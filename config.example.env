# Copy to config.local.env (git-ignored) and fill in. Read by the Makefile and scripts/.
# Your Apple developer team ID: Xcode › Settings › Accounts › your team (a free Personal Team works).
EARSHOT_TEAM_ID=
# Reverse-DNS prefix unique to you; bundle IDs become <prefix>.earshot(.broadcast/.widgets),
# the App Group group.<prefix>.earshot.
EARSHOT_BUNDLE_PREFIX=com.example
# Your iPhone's UDID: `xcrun devicectl list devices`.
EARSHOT_DEVICE=
